---
import { commentConfig } from "../../config";

const giscus = commentConfig.giscus;
const siteBase = (Astro.site ? String(Astro.site) : "https://ai.157478.xyz/").replace(/\/$/, "");
const themeLight = `${siteBase}/giscus/light.css`;
const themeDark = `${siteBase}/giscus/dark.css`;
const enabled = commentConfig.enable && commentConfig.system === "giscus";
const configured = enabled && Boolean(giscus.repo && giscus.repoId && giscus.categoryId);
const showHint = enabled && !configured && import.meta.env.DEV;
---

{
	configured && (
		<div class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 mb-4 onload-animation">
			<div class="flex flex-row items-center gap-3 mb-4">
				<div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
						<path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z" />
					</svg>
				</div>
				<div class="font-bold text-lg text-black/90 dark:text-white/90">评论</div>
			</div>
			<div
				data-giscus-config={JSON.stringify({
					repo: giscus.repo,
					"repo-id": giscus.repoId,
					category: giscus.category,
					"category-id": giscus.categoryId,
					mapping: giscus.mapping,
					strict: giscus.strict ? "1" : "0",
					"reactions-enabled": giscus.reactionsEnabled,
					"emit-metadata": "0",
					"input-position": giscus.inputPosition,
					theme: themeLight,
					"theme-light": themeLight,
					"theme-dark": themeDark,
					lang: giscus.lang,
					loading: "lazy",
				})}
			></div>
		</div>
	)
}

{showHint && <div class="mb-4 text-sm text-black/50 dark:text-white/50">评论区尚未启用：请在 src/config.ts 的 commentConfig.giscus 中填入 categoryId。</div>}
